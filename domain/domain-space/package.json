{
  "name": "@hira-ng/domain-space",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.cjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=cjs --platform=node --packages=external --outfile=dist/index.cjs"
  },
  "dependencies": {
    "@hira-ng/infra-db": "workspace:*",
    "@hira-ng/shared-types": "workspace:*",
    "@hira-ng/shared-utils": "workspace:*",
    "drizzle-orm": "^0.45.2"
  }
}
