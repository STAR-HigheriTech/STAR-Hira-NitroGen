{
  "name": "STAR-Hira-NitroGen",
  "productName": "STAR Hira",
  "private": true,
  "version": "8.0.0",
  "description": "Modular, fast, and modern AI browser.",
  "author": "STAR HigheriTech",
  "main": "out/main/index.js",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "ui/*",
    "domain/*",
    "infra/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev-pipeline.ts dev",
    "dev:web": "vite --config vite.browser.config.ts",
    "build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev-pipeline.ts build && electron-vite build",
    "workspace:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev-pipeline.ts build",
    "workspace:prepare": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev-pipeline.ts prepare",
    "plugins:build": "node ./scripts/build-plugins.ts",
    "types:build": "pnpm --filter @hira-ng/shared-types build",
    "utils:build": "pnpm --filter @hira-ng/shared-utils build",
    "infra:ipc:build": "pnpm --filter @hira-ng/infra-ipc build",
    "infra:platform:build": "pnpm --filter @hira-ng/infra-platform build",
    "infra:error:build": "pnpm --filter @hira-ng/infra-error build",
    "infra:process:build": "pnpm --filter @hira-ng/infra-process build",
    "infra:fs:build": "pnpm --filter @hira-ng/infra-fs build",
    "infra:db:build": "pnpm --filter @hira-ng/infra-db build",
    "infra:storage:build": "pnpm --filter @hira-ng/infra-storage build",
    "infra:logger:build": "pnpm --filter @hira-ng/infra-logger build",
    "infra:pwa:build": "pnpm --filter @hira-ng/infra-pwa build",
    "infra:l10n:build": "pnpm --filter @hira-ng/infra-l10n build",
    "infra:secret:build": "pnpm --filter @hira-ng/infra-secret build",
    "infra:theme:build": "pnpm --filter @hira-ng/infra-theme build",
    "infra:plugin:build": "pnpm --filter @hira-ng/infra-plugin build",
    "infra:extensions:build": "pnpm --filter @hira-ng/infra-extensions build",
    "infra:window:build": "pnpm --filter @hira-ng/infra-window build",
    "infra:build": "pnpm infra:platform:build && pnpm infra:error:build && pnpm infra:process:build && pnpm infra:fs:build && pnpm infra:ipc:build && pnpm infra:db:build && pnpm infra:storage:build && pnpm infra:logger:build && pnpm infra:pwa:build && pnpm infra:l10n:build && pnpm infra:secret:build && pnpm infra:theme:build && pnpm infra:plugin:build && pnpm infra:extensions:build && pnpm infra:window:build",
    "layout:build": "pnpm --filter @hira-ng/layout-model build && pnpm --filter @hira-ng/domain-layout build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/dev-pipeline.ts prepare && tsc --noEmit && tsc -p tsconfig.configs.json --noEmit && tsc -p tsconfig.pages.json && tsc -p apps/app-main/tsconfig.renderer.json --noEmit && tsc -p apps/app-main/tsconfig.plugins.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && pnpm --filter @hira-ng/shared-types typecheck",
    "layer:check": "node ./scripts/check-layers.ts",
    "layer:baseline": "node ./scripts/check-layers.ts --update-baseline",
    "layer:styles": "node ./scripts/check-z-index.ts",
    "pages:modules": "node ./scripts/check-page-modules.ts",
    "check:methods": "node ./scripts/check-methods.ts",
    "tokens:extract": "node ./scripts/extract-ui-tokens.ts",
    "fn:coverage": "node ./scripts/check-function-coverage.ts",
    "fn:coverage:set": "node ./scripts/set-function-coverage.ts",
    "plugin:coverage": "pnpm plugins:build && node ./scripts/check-plugin-coverage.ts",
    "plugin:new": "node ./scripts/create-plugin.ts",
    "plugin:validate": "pnpm plugins:build && node ./scripts/validate-plugin.ts",
    "test:ui-snapshot": "node ./tests/ui/snapshot-runner.ts",
    "test:ui-tabbar": "node ./scripts/electron-tool.ts ./tests/ui/tabbar/run.ts",
    "verify:plugin-runtime": "node ./scripts/verify-plugin-runtime.ts",
    "verify:split": "node ./scripts/verify-split.ts",
    "verify:plugin-install": "node ./scripts/verify-plugin-install.ts",
    "verify:plugin-market": "node ./scripts/verify-plugin-market.ts",
    "verify:plugin-publish": "node ./scripts/verify-plugin-publish.ts",
    "verify:settings-page": "node ./scripts/electron-tool.ts ./scripts/verify-settings-page.ts",
    "plugin:publish": "node ./scripts/plugin-publish.ts",
    "pack:win": "pnpm build && node ./scripts/pack-win.ts",
    "pack:win:publish": "pnpm build && node ./scripts/pack-win.ts --publish",
    "icons:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-icons.ps1",
    "test": "vitest run",
    "domain:tabs:build": "pnpm --filter @hira-ng/domain-tabs build",
    "domain:bookmark:build": "pnpm --filter @hira-ng/domain-bookmark build",
    "domain:history:build": "pnpm --filter @hira-ng/domain-history build",
    "domain:search:build": "pnpm --filter @hira-ng/domain-search build",
    "domain:password:build": "pnpm --filter @hira-ng/domain-password build",
    "domain:download:build": "pnpm --filter @hira-ng/domain-download build",
    "domain:profile:build": "pnpm --filter @hira-ng/domain-profile build",
    "domain:settings:build": "pnpm --filter @hira-ng/domain-settings build",
    "domain:space:build": "pnpm --filter @hira-ng/domain-space build",
    "domain:session:build": "pnpm --filter @hira-ng/domain-session build",
    "domain:favicon:build": "pnpm --filter @hira-ng/domain-favicon build",
    "domain:permission:build": "pnpm --filter @hira-ng/domain-permission build",
    "domain:notes:build": "pnpm --filter @hira-ng/domain-notes build",
    "domain:totp:build": "pnpm --filter @hira-ng/domain-totp build",
    "domain:translate:build": "pnpm --filter @hira-ng/domain-translate build",
    "domain:extension:build": "pnpm --filter @hira-ng/domain-extension build",
    "domain:pwa:build": "pnpm --filter @hira-ng/domain-pwa build",
    "domain:build": "pnpm domain:tabs:build && pnpm domain:bookmark:build && pnpm domain:history:build && pnpm domain:search:build && pnpm domain:password:build && pnpm domain:download:build && pnpm domain:profile:build && pnpm domain:settings:build && pnpm domain:space:build && pnpm domain:session:build && pnpm domain:favicon:build && pnpm domain:permission:build && pnpm domain:notes:build && pnpm domain:totp:build && pnpm domain:translate:build && pnpm domain:extension:build && pnpm domain:pwa:build"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.0",
    "drizzle-kit": "^0.31.10",
    "electron": "https://codeload.github.com/castlabs/electron-releases/tar.gz/8244344c33634d9323377c0d0fd1d9b7f9b69540",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "9",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@hira-ng/infra-window": "workspace:*",
    "@hira-ng/infra-ipc": "workspace:*",
    "@hira-ng/infra-db": "workspace:*",
    "@hira-ng/infra-extensions": "workspace:*",
    "@hira-ng/infra-process": "workspace:*",
    "@hira-ng/infra-plugin": "workspace:*",
    "@hira-ng/infra-theme": "workspace:*",
    "@hira-ng/infra-pwa": "workspace:*",
    "@hira-ng/infra-fs": "workspace:*",
    "@hira-ng/infra-l10n": "workspace:*",
    "@hira-ng/infra-net-guard": "workspace:*",
    "@hira-ng/infra-secret": "workspace:*",
    "@hira-ng/domain-bookmark": "workspace:*",
    "@hira-ng/domain-history": "workspace:*",
    "@hira-ng/domain-download": "workspace:*",
    "@hira-ng/domain-tabs": "workspace:*",
    "@hira-ng/domain-password": "workspace:*",
    "@hira-ng/domain-permission": "workspace:*",
    "@hira-ng/domain-pwa": "workspace:*",
    "@hira-ng/domain-search": "workspace:*",
    "@hira-ng/domain-extension": "workspace:*",
    "@hira-ng/domain-favicon": "workspace:*",
    "@hira-ng/domain-notes": "workspace:*",
    "@hira-ng/domain-layout": "workspace:*",
    "@hira-ng/domain-profile": "workspace:*",
    "@hira-ng/domain-session": "workspace:*",
    "@hira-ng/domain-settings": "workspace:*",
    "@hira-ng/domain-space": "workspace:*",
    "@hira-ng/domain-totp": "workspace:*",
    "@hira-ng/domain-translate": "workspace:*",
    "@hira-ng/shared-utils": "workspace:*",
    "@hira-ng/shared-types": "workspace:*",
    "@hira-ng/layout-model": "workspace:*",
    "@hira-ng/layout-engine": "workspace:*",
    "@hira-ng/ui-layout-editor": "workspace:*",
    "@browsermt/bergamot-translator": "0.4.9",
    "@ghostery/adblocker-electron": "2.18.2",
    "better-sqlite3": "^13.0.3",
    "chokidar": "5.0.0",
    "dragula": "3.7.3",
    "drizzle-orm": "^0.45.2",
    "electron-chrome-context-menu": "1.1.0",
    "@iamevan/electron-chrome-extensions": "npm:@iamevan/electron-chrome-extensions@4.9.4",
    "@iamevan/electron-chrome-web-store": "npm:@iamevan/electron-chrome-web-store@0.13.5",
    "electron-squirrel-startup": "1.0.1",
    "electron-updater": "6.8.11",
    "expr-eval": "2.0.2",
    "koffi": "3.1.4",
    "node-abi": "4.33.0",
    "papaparse": "5.5.4",
    "pdfjs-dist": "6.1.200",
    "punycode": "2.3.1",
    "qr": "0.7.2",
    "quick-score": "0.2.0",
    "regedit": "5.1.4",
    "sortablejs": "1.15.7",
    "stemmer": "2.0.1",
    "write-file-atomic": "7.0.1",
    "zod": "^4.5.4"
  },
  "build": {
    "appId": "com.starhigheritech.hira-ng",
    "productName": "STAR Hira",
    "artifactName": "STAR-Hira-NitroGen-Setup-${version}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "build/plugins/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "apps/app-main/cli",
        "to": "cli",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "out/main/plugin-host.js"
    ],
    "win": {
      "executableName": "STAR Hira NitroGen",
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "include": "installer.nsh",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "installerIcon.ico",
      "uninstallerIcon": "uninstallerIcon.ico",
      "installerHeaderIcon": "installerHeaderIcon.ico",
      "installerHeader": "installerHeader.bmp",
      "installerSidebar": "installerSidebar.bmp"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "STAR-HigheriTech",
        "repo": "STAR-Hira-NitroGen"
      }
    ]
  }
}
