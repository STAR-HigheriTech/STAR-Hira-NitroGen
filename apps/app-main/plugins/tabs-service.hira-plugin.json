{
  "id": "tabs-service",
  "name": "标签引擎",
  "version": "0.0.1",
  "type": "core",
  "trustLevel": "core",
  "description": "提供标签的创建、切换、关闭、排序、固定、静音、休眠与导航能力。",
  "main": "./tabs-service.cjs",
  "capabilities": [
    "tabs.list",
    "tabs.projection",
    "tabs.stack-create",
    "tabs.stack-set",
    "tabs.stack-toggle",
    "tabs.stack-rename",
    "tabs.stack-set-color",
    "tabs.stack-merge",
    "tabs.stack-dissolve",
    "tabs.stack-get",
    "tabs.stack-of-tab",
    "tabs.stack-list",
    "tabs.stack-is-tab-in-any",
    "tabs.stack-update",
    "tabs.create",
    "tabs.create-incognito",
    "tabs.activate",
    "tabs.close",
    "tabs.close-others",
    "tabs.close-right",
    "tabs.reorder",
    "tabs.toggle-pin",
    "tabs.toggle-mute",
    "tabs.duplicate",
    "tabs.can-go-back",
    "tabs.can-go-forward",
    "tabs.undo-close",
    "tabs.navigate",
    "tabs.back",
    "tabs.forward",
    "tabs.reload",
    "tabs.stop",
    "tabs.sleep",
    "tabs.wake",
    "tabs.sleep-inactive",
    "tabs.get-active",
    "tabs.next",
    "tabs.prev",
    "tabs.omnibox-action",
    "tabs.recently-closed",
    "tabs.recently-closed:clear",
    "tabs.recently-closed:restore"
  ],
  "dependsOn": []
}
