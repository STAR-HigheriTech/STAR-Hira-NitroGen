{
  "id": "notes-service",
  "name": "集锦引擎",
  "version": "0.0.1",
  "type": "feature-plugin",
  "trustLevel": "internal",
  "description": "提供集锦与集锦文件夹的增删改查、搜索、排序、置顶能力，不含界面。",
  "main": "./notes-service.cjs",
  "capabilities": [
    "notes.list",
    "notes.get",
    "notes.add",
    "notes.update",
    "notes.remove",
    "notes.search",
    "notes.move",
    "notes.setPinned",
    "notes.reorder",
    "notes.listFolders",
    "notes.addFolder",
    "notes.renameFolder",
    "notes.removeFolder",
    "notes.moveFolder",
    "notes.reorderFolders",
    "notes.folderCounts",
    "notes.addCaptured",
    "notes.restore",
    "notes.purge",
    "notes.listTrash",
    "notes.emptyTrash",
    "notes.backlinks",
    "notes.refCounts"
  ],
  "dependsOn": []
}
