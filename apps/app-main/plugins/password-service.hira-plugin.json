{
  "id": "password-service",
  "name": "密码引擎",
  "version": "0.0.1",
  "type": "feature-plugin",
  "trustLevel": "internal",
  "description": "统一内置加密库等密码后端，提供凭据读写与「永不保存」域名管理。",
  "main": "./password-service.cjs",
  "capabilities": [
    "password.listBackends",
    "password.saveCredential",
    "password.getSuggestions",
    "password.deleteCredential",
    "password.listCredentials",
    "password.importCredentials",
    "password.setActiveBackend",
    "password.backendAction",
    "password.addNeverSave",
    "password.removeNeverSave",
    "password.listNeverSave",
    "password.getBackendStatus"
  ],
  "dependsOn": []
}
