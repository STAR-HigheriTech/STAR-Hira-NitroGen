{
  "id": "bookmark-service",
  "name": "书签引擎",
  "version": "0.0.1",
  "type": "feature-plugin",
  "trustLevel": "internal",
  "description": "提供书签的增删改查、文件夹、树结构与排序能力，不含界面。",
  "main": "./bookmark-service.cjs",
  "capabilities": [
    "bookmark.list",
    "bookmark.add",
    "bookmark.remove",
    "bookmark.update",
    "bookmark.search",
    "bookmark.move",
    "bookmark.exportHtml",
    "bookmark.importHtml",
    "bookmark.getByUrl",
    "bookmark.removeByUrl",
    "bookmark.tree",
    "bookmark.listPinned",
    "bookmark.setPinned",
    "bookmark.reorderPinned",
    "bookmark.listRailPinned",
    "bookmark.setRailPinned",
    "bookmark.reorderRailPinned",
    "bookmark.setOpenInSidebar",
    "bookmark.reorderChildren",
    "bookmark.listTags",
    "bookmark.suggestTags",
    "bookmark.autocompleteTags",
    "bookmark.bulkUpdateTags",
    "bookmark.bulkSetPinned",
    "bookmark.bulkSetRailPinned",
    "bookmark.deleteTag",
    "bookmark.snapshot"
  ],
  "dependsOn": []
}
