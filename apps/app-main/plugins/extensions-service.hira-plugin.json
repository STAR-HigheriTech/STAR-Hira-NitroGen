{
  "id": "extensions-service",
  "name": "扩展引擎",
  "version": "0.0.1",
  "type": "feature-plugin",
  "trustLevel": "internal",
  "description": "提供 Chrome 扩展的安装、卸载、启停与内容拦截状态能力。",
  "main": "./extensions-service.cjs",
  "capabilities": [
    "extensions.installFromCrx",
    "extensions.uninstall",
    "extensions.listExtensions",
    "extensions.toggle",
    "extensions.setPinned",
    "extensions.iconPath",
    "extensions.optionsUrl",
    "extensions.openPopup",
    "extensions.installFromPath",
    "extensions.adblockerStatus",
    "extensions.adblockerLevel",
    "extensions.adblockerSetLevel",
    "extensions.adblockerToggle",
    "extensions.adblockerBlockedCount",
    "extensions.runtimeStatus",
    "extensions.reload",
    "extensions.diagnostics",
    "extensions.warnings",
    "extensions.inspectViewSources",
    "extensions.browserActionStates",
    "extensions.browserActionIcon",
    "extensions.inspectView",
    "extensions.updateAll",
    "extensions.newTabOverrideUrl"
  ],
  "dependsOn": []
}
