{
  "name": "@hira-ng/infra-extensions",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.cjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=cjs --platform=node --packages=external --outfile=dist/index.cjs"
  },
  "dependencies": {
    "@iamevan/electron-chrome-extensions": "4.9.4",
    "@iamevan/electron-chrome-web-store": "0.13.5",
    "@ghostery/adblocker-electron": "2.18.2",
    "adm-zip": "0.5.18",
    "@hira-ng/shared-types": "workspace:*"
  }
}
